# .env.example 를 .env 로 복사한 뒤 값을 채우세요.
# Claude Desktop 설정의 "env" 에 같은 값을 넣으면 그쪽이 우선합니다.

# 키는 둘 중 하나로 지정 (OPENAI_API_KEY 가 있으면 그쪽이 우선)
# OPENAI_API_KEY=sk-...
OPENAI_API_KEY_FILE=D:/github/sg_dev/cross/data/openai/gptimage_sggim.api_key

# 결과 저장 폴더 (기본: ~/Pictures/openai_image_mcp)
# OUTPUT_DIR=D:/work/ai_images

# OPENAI_IMAGE_MODEL=gpt-image-2
# DEFAULT_QUALITY=medium
# OPENAI_TIMEOUT=240
# TOOL_WAIT_SECONDS=50
# PREVIEW_MAX_PX=768

# fake 로 두면 API 호출 없이 더미 이미지 (테스트용)
# IMAGE_BACKEND=fake
